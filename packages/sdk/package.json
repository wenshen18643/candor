{
  "name": "@candor/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader native --pool threads",
    "api:generate": "openapi-typescript ../../services/api/openapi.json -o src/api.generated.ts && prettier --write src/api.generated.ts",
    "seed:demo": "node --import ./src/cli/register.mjs ./src/cli/seed-demo.ts"
  },
  "dependencies": {
    "@candor/crypto": "workspace:*",
    "@candor/privacy": "workspace:*",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
